{
  "name": "theia-chat-debug",
  "version": "0.1.0",
  "description": "Chat Debug view and LLM request/response tracing for Theia AI",
  "keywords": [
    "theia-extension",
    "ai",
    "chat-debug",
    "llm-trace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocrates/theia-chat-debug.git"
  },
  "bugs": {
    "url": "https://github.com/cocrates/theia-chat-debug/issues"
  },
  "homepage": "https://github.com/cocrates/theia-chat-debug",
  "files": [
    "lib",
    "src"
  ],
  "peerDependencies": {
    "@theia/ai-core": ">=1.76.0",
    "@theia/core": ">=1.76.0",
    "@theia/filesystem": ">=1.76.0",
    "@theia/output": ">=1.76.0",
    "@theia/workspace": ">=1.76.0"
  },
  "devDependencies": {
    "@theia/ai-core": "1.77.0-next.25",
    "@theia/core": "1.77.0-next.25",
    "@theia/filesystem": "1.77.0-next.25",
    "@theia/output": "1.77.0-next.25",
    "@theia/workspace": "1.77.0-next.25",
    "@types/react": "^19.0.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "prepare": "npm run clean && npm run build",
    "clean": "rimraf lib *.tsbuildinfo",
    "build": "tsc",
    "watch": "tsc -w"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/theia-chat-debug-frontend-module"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
